[gd_scene format=3]
[ext_resource type="Script" path="res://Scripts/HealthComponent.cs" id="HealthComponent"]
[ext_resource type="Script" path="res://Scripts/ShootComponent.cs" id="ShootComponent"]
[ext_resource type="Script" path="res://Scripts/PlayerController.cs" id="PlayerController"]
[ext_resource type="Script" path="res://Scripts/BuildComponent.cs" id="BuildComponent"]
[ext_resource type="PackedScene" path="res://Scenes/BasicBullet.tscn" id="BasicBullet"]
[ext_resource type="PackedScene" path="res://Scenes/BasicTower.tscn" id="BasicTower"]
[ext_resource type="PackedScene" path="res://Scenes/ExplosiveTower.tscn" id="ExplosiveTower"]
[ext_resource type="PackedScene" path="res://Scenes/FreezeTower.tscn" id="FreezeTower"]

[sub_resource type="CylinderShape3D" id="bodyshape"]
radius = 0.65
height = 2.0
[sub_resource type="BoxMesh" id="bodymesh"]
size = Vector3(0.9, 1.5, 0.9)
[sub_resource type="StandardMaterial3D" id="bodymaterial"]
albedo_color = Color(0.25, 1, 0.3, 1)
[sub_resource type="BoxMesh" id="gunmesh"]
size = Vector3(0.32, 0.35, 1.8)
[sub_resource type="StandardMaterial3D" id="gunmaterial"]
albedo_color = Color(0.5, 1, 0.65, 1)
[sub_resource type="SphereShape3D" id="sight"]
radius = 11

[node name="Player" type="CharacterBody3D" groups=["Allies", "Player"]]
collision_layer = 1
collision_mask = 3
[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
position = Vector3(0, 1, 0)
shape = SubResource("bodyshape")
[node name="TowerBaseVisual" type="MeshInstance3D" parent="."]
position = Vector3(0, 1, 0)
mesh = SubResource("bodymesh")
material_override = SubResource("bodymaterial")
[node name="MuzzleVisual" type="Node3D" parent="."]
position = Vector3(0, 1, 0)
[node name="Gun" type="MeshInstance3D" parent="MuzzleVisual"]
position = Vector3(0, 0, -0.7)
mesh = SubResource("gunmesh")
material_override = SubResource("gunmaterial")
[node name="MuzzleMarker" type="Marker3D" parent="MuzzleVisual"]
position = Vector3(0, 0, -1.8)

[node name="HealthComponent" type="Node" parent="."]
script = ExtResource("HealthComponent")
MaxHealth = 30

[node name="ShootComponent" type="Node" parent="."]
script = ExtResource("ShootComponent")
BulletScene = ExtResource("BasicBullet")
ShotInterval = 0.25
PlayerControlled = true
TargetGroup = "Enemies"

[node name="PlayerController" type="Node" parent="."]
script = ExtResource("PlayerController")


[node name="BuildComponent" type="Node" parent="."]
script = ExtResource("BuildComponent")
TowerScenes = Array[PackedScene]([ExtResource("BasicTower"), ExtResource("ExplosiveTower"), ExtResource("FreezeTower")])
